// ============================================================
// RAW EXPORT
// ============================================================

async fn raw_export(State(state): State<AppState>, headers: HeaderMap) -> Response {
    state
        .request_counter
        .with_label_values(&["raw_export"])
        .inc();

    let authenticated_user = match authenticate_request(&state, &headers).await {
        Ok(user) => user,

        Err(response) => return response,
    };

    let allowed = match opa_authorize(
        &state,
        true,
        &authenticated_user.role,
        "raw_export",
        &authenticated_user.institution,
        &state.dataset_id,
        "raw_export",
        true,
    )
    .await
    {
        Ok(decision) => decision,

        Err(err) => {
            state
                .denied_counter
                .with_label_values(&["opa_unavailable"])
                .inc();

            state
                .opa_decision_counter
                .with_label_values(&["error"])
                .inc();

            warn!(
                site = %state.site_id,
                username = %authenticated_user.username,
                institution = %authenticated_user.institution,
                action = "RAW_EXPORT",
                decision = "DENY",
                reason = "opa_unavailable",
                error = %err,
                "OPA authorization unavailable"
            );

            return (
                StatusCode::SERVICE_UNAVAILABLE,
                "Authorization service unavailable",
            )
                .into_response();
        }
    };

    if !allowed {
        state
            .denied_counter
            .with_label_values(&["raw_export"])
            .inc();

        state
            .opa_decision_counter
            .with_label_values(&["deny"])
            .inc();

        warn!(
            site = %state.site_id,
            username = %authenticated_user.username,
            institution = %authenticated_user.institution,
            role = %authenticated_user.role,
            action = "RAW_EXPORT",
            dataset = %state.dataset_id,
            decision = "DENY",
            reason = "opa_policy",
            "Raw genomic export denied"
        );

        return (
            StatusCode::FORBIDDEN,
            "Raw genomic export prohibited by federation policy",
        )
            .into_response();
    }

    state
        .opa_decision_counter
        .with_label_values(&["allow"])
        .inc();

    (
        StatusCode::NOT_IMPLEMENTED,
        "Raw genomic export implementation is disabled",
    )
        .into_response()
}

// ============================================================
// SUBMIT JOB
// ============================================================

async fn submit_job(
    State(state): State<AppState>,

    headers: HeaderMap,

    Json(request): Json<JobRequest>,
) -> Response {
    state
        .request_counter
        .with_label_values(&["submit_job"])
        .inc();

    let authenticated_user = match authenticate_request(&state, &headers).await {
        Ok(user) => user,

        Err(response) => return response,
    };

    let requester = authenticated_user.username.clone();

    let institution = authenticated_user.institution.clone();

    let role = authenticated_user.role.clone();

    if request.dataset_id != state.dataset_id {
        state
            .denied_counter
            .with_label_values(&["unknown_dataset"])
            .inc();

        warn!(
            site = %state.site_id,
            requester = %requester,
            institution = %institution,
            dataset = %request.dataset_id,
            decision = "DENY",
            reason = "unknown_dataset",
            "Federation job rejected"
        );

        return (StatusCode::FORBIDDEN, "Dataset not authorized at this site").into_response();
    }

    let opa_allowed = match opa_authorize(
        &state,
        true,
        &role,
        "submit_analysis",
        &institution,
        &request.dataset_id,
        &request.workflow,
        false,
    )
    .await
    {
        Ok(decision) => decision,

        Err(err) => {
            state.denied_counter.with_label_values(&["opa_error"]).inc();

            state
                .opa_decision_counter
                .with_label_values(&["error"])
                .inc();

            warn!(
                site = %state.site_id,
                requester = %requester,
                institution = %institution,
                role = %role,
                dataset = %request.dataset_id,
                workflow = %request.workflow,
                decision = "DENY",
                reason = "opa_unavailable",
                error = %err,
                "OPA authorization failed"
            );

            return (
                StatusCode::SERVICE_UNAVAILABLE,
                "Authorization service unavailable",
            )
                .into_response();
        }
    };

    if !opa_allowed {
        state
            .denied_counter
            .with_label_values(&["opa_policy"])
            .inc();

        state
            .opa_decision_counter
            .with_label_values(&["deny"])
            .inc();

        warn!(
            site = %state.site_id,
            requester = %requester,
            institution = %institution,
            role = %role,
            dataset = %request.dataset_id,
            workflow = %request.workflow,
            decision = "DENY",
            reason = "opa_policy",
            "OPA denied federation job"
        );

        return (StatusCode::FORBIDDEN, "OPA authorization denied").into_response();
    }

    state
        .opa_decision_counter
        .with_label_values(&["allow"])
        .inc();

    let job_id = Uuid::new_v4().to_string();

    let created_at = Utc::now().to_rfc3339();

    {
        let db = match state.db.lock() {
            Ok(db) => db,

            Err(_) => {
                return (StatusCode::INTERNAL_SERVER_ERROR, "Database unavailable").into_response();
            }
        };

        if let Err(err) = db.execute(
            "
                INSERT INTO jobs (
                    job_id,
                    site,
                    dataset_id,
                    workflow,
                    status,
                    created_at
                )
                VALUES (
                    ?1,
                    ?2,
                    ?3,
                    ?4,
                    'QUEUED',
                    ?5
                )
                ",
            params![
                job_id,
                state.site_id,
                request.dataset_id,
                request.workflow,
                created_at,
            ],
        ) {
            error!(
                site = %state.site_id,
                error = %err,
                "Database insert failed"
            );

            return (StatusCode::INTERNAL_SERVER_ERROR, "Database error").into_response();
        }
    }

    info!(
        job_id = %job_id,
        site = %state.site_id,
        requester = %requester,
        institution = %institution,
        role = %role,
        dataset = %request.dataset_id,
        workflow = %request.workflow,
        authentication = "Keycloak-JWT",
        authorization = "OPA",
        decision = "ALLOW",
        "Federated job accepted"
    );

    let background_state = state.clone();

    let background_job_id = job_id.clone();

    let background_dataset = request.dataset_id.clone();

    let background_workflow = request.workflow.clone();

    tokio::spawn(async move {
        let started_at = Utc::now().to_rfc3339();

        {
            if let Ok(db) = background_state.db.lock() {
                let _ = db.execute(
                    "
                            UPDATE jobs
                            SET
                                status = 'RUNNING',
                                started_at = ?1
                            WHERE
                                job_id = ?2
                            ",
                    params![started_at, background_job_id,],
                );
            }
        }

        let timer = Instant::now();

        let short_job_id = background_job_id.chars().take(8).collect::<String>();

        let nextflow_name = format!("fed_{}", short_job_id);

        let run_id = format!("{}-{}", background_state.site_id, nextflow_name);

        let log_directory = PathBuf::from("/genomics/work/federation/logs");

        if let Err(err) = fs::create_dir_all(&log_directory) {
            error!(
                job_id = %background_job_id,
                error = %err,
                "Unable to create federation log directory"
            );
        }

        let log_path = log_directory.join(format!("{}.log", background_job_id));

        // Resume is enabled by default for existing deployments.
        // Set NEXTFLOW_RESUME=false for a controlled fresh-execution experiment.
        let resume_enabled = env::var("NEXTFLOW_RESUME")
            .map(|value| value.eq_ignore_ascii_case("true"))
            .unwrap_or(true);

        let mut command = Command::new("/usr/local/bin/nextflow");
        command
            .arg("run")
            .arg("main.nf")
            .arg("--run_id")
            .arg(&run_id)
            .arg("-name")
            .arg(&nextflow_name);

        if resume_enabled {
            command.arg("-resume");
        }

        info!(
            job_id = %background_job_id,
            resume_enabled = resume_enabled,
            "Launching Nextflow workflow"
        );

        let output = command
            .current_dir(&background_state.pipeline_dir)
            .output()
            .await;

        let duration_seconds = timer.elapsed().as_secs_f64();

        background_state
            .job_duration
            .with_label_values(&[&background_workflow])
            .observe(duration_seconds);

        let completed_at = Utc::now().to_rfc3339();

        match output {
            Ok(output) => {
                let mut log_data = Vec::new();

                log_data.extend_from_slice(b"===== STDOUT =====\n");

                log_data.extend_from_slice(&output.stdout);

                log_data.extend_from_slice(b"\n===== STDERR =====\n");

                log_data.extend_from_slice(&output.stderr);

                if let Err(err) = fs::write(&log_path, log_data) {
                    error!(
                        job_id = %background_job_id,
                        error = %err,
                        "Unable to write workflow log"
                    );
                }

                let exit_code = output.status.code().unwrap_or(-1);

                let final_status = if output.status.success() {
                    "COMPLETED"
                } else {
                    "FAILED"
                };

                {
                    if let Ok(db) = background_state.db.lock() {
                        let _ = db.execute(
                            "
                                    UPDATE jobs
                                    SET
                                        status = ?1,
                                        completed_at = ?2,
                                        exit_code = ?3,
                                        log_path = ?4
                                    WHERE
                                        job_id = ?5
                                    ",
                            params![
                                final_status,
                                completed_at,
                                exit_code,
                                log_path.to_string_lossy().to_string(),
                                background_job_id,
                            ],
                        );
                    }
                }

                info!(
                    job_id = %background_job_id,
                    site = %background_state.site_id,
                    dataset = %background_dataset,
                    workflow = %background_workflow,
                    status = %final_status,
                    exit_code = exit_code,
                    duration_seconds = duration_seconds,
                    "Federated workflow finished"
                );
            }

            Err(err) => {
                let failure_message = format!("Failed to launch Nextflow workflow: {err}\n");

                let _ = fs::write(&log_path, failure_message);

                {
                    if let Ok(db) = background_state.db.lock() {
                        let _ = db.execute(
                            "
                                    UPDATE jobs
                                    SET
                                        status = 'FAILED',
                                        completed_at = ?1,
                                        exit_code = -1,
                                        log_path = ?2
                                    WHERE
                                        job_id = ?3
                                    ",
                            params![
                                completed_at,
                                log_path.to_string_lossy().to_string(),
                                background_job_id,
                            ],
                        );
                    }
                }

                error!(
                    job_id = %background_job_id,
                    site = %background_state.site_id,
                    dataset = %background_dataset,
                    workflow = %background_workflow,
                    error = %err,
                    "Federated workflow launch failed"
                );
            }
        }
    });

    (
        StatusCode::ACCEPTED,
        Json(JobSubmissionResponse {
            job_id,

            site: state.site_id,

            status: "QUEUED".to_string(),
        }),
    )
        .into_response()
}

