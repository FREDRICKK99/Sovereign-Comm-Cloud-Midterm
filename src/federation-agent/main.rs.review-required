// ============================================================
// LOAD PRIVATE FEDERATION CA
// ============================================================

fn load_ca_certificate(path: &str) -> anyhow::Result<reqwest::Certificate> {
    let pem = fs::read(path)?;

    let certificate = reqwest::Certificate::from_pem(&pem)?;

    Ok(certificate)
}

// ============================================================
// LOAD KEYCLOAK JWKS
// ============================================================

async fn load_jwt_keys(
    client: &Client,
    issuers: &[TrustedIssuer],
) -> anyhow::Result<HashMap<String, JwtKey>> {
    let mut keys = HashMap::new();

    for trusted in issuers {
        info!(
            issuer = %trusted.issuer,
            jwks_url = %trusted.jwks_url,
            "Loading Keycloak JWKS"
        );

        let response = client
            .get(&trusted.jwks_url)
            .send()
            .await?
            .error_for_status()?;

        let jwks: JwkSet = response.json().await?;

        for jwk in jwks.keys {
            let Some(kid) = jwk.common.key_id.clone() else {
                warn!(
                    issuer = %trusted.issuer,
                    "Ignoring JWKS key without kid"
                );

                continue;
            };

            let decoding_key = match DecodingKey::from_jwk(&jwk) {
                Ok(key) => key,

                Err(err) => {
                    warn!(
                        issuer = %trusted.issuer,
                        kid = %kid,
                        error = %err,
                        "Unable to use JWKS key"
                    );

                    continue;
                }
            };

            let cache_key = format!("{}|{}", trusted.issuer, kid);

            keys.insert(cache_key, JwtKey { key: decoding_key });
        }
    }

    if keys.is_empty() {
        anyhow::bail!("No usable Keycloak JWT verification keys were loaded");
    }

    info!(key_count = keys.len(), "Keycloak verification keys loaded");

    Ok(keys)
}

// ============================================================
// JWT AUTHENTICATION
// ============================================================

async fn authenticate_request(
    state: &AppState,
    headers: &HeaderMap,
) -> Result<AuthenticatedUser, Response> {
    let authorization = match headers.get(header::AUTHORIZATION) {
        Some(value) => value,

        None => {
            state.jwt_counter.with_label_values(&["missing"]).inc();

            return Err((StatusCode::UNAUTHORIZED, "Missing Authorization header").into_response());
        }
    };

    let authorization = match authorization.to_str() {
        Ok(value) => value,

        Err(_) => {
            state
                .jwt_counter
                .with_label_values(&["invalid_header"])
                .inc();

            return Err((StatusCode::UNAUTHORIZED, "Invalid Authorization header").into_response());
        }
    };

    let Some(token) = authorization.strip_prefix("Bearer ") else {
        state.jwt_counter.with_label_values(&["not_bearer"]).inc();

        return Err((
            StatusCode::UNAUTHORIZED,
            "Authorization must use Bearer token",
        )
            .into_response());
    };

    if token.trim().is_empty() {
        return Err((StatusCode::UNAUTHORIZED, "Bearer token is empty").into_response());
    }

    let jwt_header = match decode_header(token) {
        Ok(header) => header,

        Err(err) => {
            state.jwt_counter.with_label_values(&["invalid"]).inc();

            warn!(
                error = %err,
                "JWT header decoding failed"
            );

            return Err((StatusCode::UNAUTHORIZED, "Invalid JWT").into_response());
        }
    };

    if jwt_header.alg != Algorithm::RS256 {
        state.jwt_counter.with_label_values(&["algorithm"]).inc();

        warn!(
            algorithm = ?jwt_header.alg,
            "JWT rejected due to unsupported algorithm"
        );

        return Err((StatusCode::UNAUTHORIZED, "Unsupported JWT algorithm").into_response());
    }

    let Some(kid) = jwt_header.kid else {
        state.jwt_counter.with_label_values(&["missing_kid"]).inc();

        return Err((StatusCode::UNAUTHORIZED, "JWT missing kid").into_response());
    };

    for trusted in &state.trusted_issuers {
        let cache_key = format!("{}|{}", trusted.issuer, kid);

        let Some(jwt_key) = state.jwt_keys.get(&cache_key) else {
            continue;
        };

        let mut validation = Validation::new(Algorithm::RS256);

        validation.set_issuer(&[trusted.issuer.as_str()]);

        validation.set_required_spec_claims(&["exp", "iss", "sub"]);

        validation.validate_exp = true;

        validation.set_audience(&[state.jwt_audience.as_str()]);

        validation.validate_aud = true;

        validation.leeway = 30;

        let decoded = match decode::<JwtClaims>(token, &jwt_key.key, &validation) {
            Ok(decoded) => decoded,

            Err(_) => continue,
        };

        let claims = decoded.claims;

        if claims.iss != trusted.issuer {
            continue;
        }

        let username = claims
            .preferred_username
            .unwrap_or_else(|| claims.sub.clone());

        let roles = claims
            .realm_access
            .map(|realm| realm.roles)
            .unwrap_or_default();

        let role = if roles
            .iter()
            .any(|candidate| candidate == "institution-admin")
        {
            "institution-admin"
        } else if roles.iter().any(|candidate| candidate == "data-steward") {
            "data-steward"
        } else if roles.iter().any(|candidate| candidate == "researcher") {
            "researcher"
        } else {
            state.jwt_counter.with_label_values(&["no_role"]).inc();

            warn!(
                username = %username,
                issuer = %claims.iss,
                "Authenticated user has no federation role"
            );

            return Err((StatusCode::FORBIDDEN, "No authorized federation role").into_response());
        };

        state.jwt_counter.with_label_values(&["valid"]).inc();

        info!(
            username = %username,
            institution = %trusted.institution,
            role = %role,
            issuer = %trusted.issuer,
            audience = %state.jwt_audience,
            "JWT authentication successful"
        );

        return Ok(AuthenticatedUser {
            username,

            institution: trusted.institution.clone(),

            role: role.to_string(),
        });
    }

    state
        .jwt_counter
        .with_label_values(&["verification_failed"])
        .inc();

    warn!(
        kid = %kid,
        expected_audience = %state.jwt_audience,
        "JWT verification failed"
    );

    Err((StatusCode::UNAUTHORIZED, "JWT verification failed").into_response())
}

// ============================================================
// OPA AUTHORIZATION
// ============================================================

async fn opa_authorize(
    state: &AppState,

    authenticated: bool,

    role: &str,

    action: &str,

    institution: &str,

    dataset_id: &str,

    workflow: &str,

    raw_export: bool,
) -> Result<bool, String> {
    let payload = OpaRequest {
        input: OpaInput {
            authenticated,

            role: role.to_string(),

            action: action.to_string(),

            institution: institution.to_string(),

            dataset_id: dataset_id.to_string(),

            workflow: workflow.to_string(),

            raw_export,
        },
    };

    let response = state
        .http_client
        .post(&state.opa_url)
        .json(&payload)
        .send()
        .await
        .map_err(|err| format!("OPA request failed: {err}"))?;

    let status = response.status();

    if !status.is_success() {
        return Err(format!("OPA returned HTTP {}", status));
    }

    let decision: OpaResponse = response
        .json()
        .await
        .map_err(|err| format!("Invalid OPA response: {err}"))?;

    Ok(decision.result.unwrap_or(false))
}

