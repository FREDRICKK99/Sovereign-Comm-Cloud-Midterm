// JOB STATUS
// ============================================================

async fn job_status(Path(job_id): Path<String>, State(state): State<AppState>) -> Response {
    state
        .request_counter
        .with_label_values(&["job_status"])
        .inc();

    let db = match state.db.lock() {
        Ok(db) => db,

        Err(_) => {
            return (StatusCode::INTERNAL_SERVER_ERROR, "Database unavailable").into_response();
        }
    };

    let mut statement = match db.prepare(
        "
            SELECT
                job_id,
                site,
                dataset_id,
                workflow,
                status,
                created_at,
                started_at,
                completed_at,
                exit_code,
                log_path
            FROM jobs
            WHERE job_id = ?1
            ",
    ) {
        Ok(statement) => statement,

        Err(err) => {
            error!(
                error = %err,
                "Could not prepare job-status query"
            );

            return (StatusCode::INTERNAL_SERVER_ERROR, "Database error").into_response();
        }
    };

    let result = statement.query_row(params![job_id], |row| {
        Ok(JobStatusResponse {
            job_id: row.get(0)?,

            site: row.get(1)?,

            dataset_id: row.get(2)?,

            workflow: row.get(3)?,

            status: row.get(4)?,

            created_at: row.get(5)?,

            started_at: row.get(6)?,

            completed_at: row.get(7)?,

            exit_code: row.get(8)?,

            log_path: row.get(9)?,
        })
    });

    match result {
        Ok(job) => Json(job).into_response(),

        Err(rusqlite::Error::QueryReturnedNoRows) => {
            (StatusCode::NOT_FOUND, "Job not found").into_response()
        }

        Err(err) => {
            error!(
                error = %err,
                "Job-status query failed"
            );

            (StatusCode::INTERNAL_SERVER_ERROR, "Database error").into_response()
        }
    }
}

// ============================================================
// PROMETHEUS METRICS
// ============================================================

async fn metrics(State(state): State<AppState>) -> Response {
    let encoder = TextEncoder::new();

    let metric_families = state.registry.gather();

    let mut buffer = Vec::new();

    if let Err(err) = encoder.encode(&metric_families, &mut buffer) {
        error!(
            error = %err,
            "Could not encode Prometheus metrics"
        );

        return (StatusCode::INTERNAL_SERVER_ERROR, "Metric encoding error").into_response();
    }

    (
        [(header::CONTENT_TYPE, encoder.format_type().to_string())],
        buffer,
    )
        .into_response()
}

// ============================================================
// DATABASE
// ============================================================

fn initialize_database(database_path: &str) -> anyhow::Result<Connection> {
    if let Some(parent) = PathBuf::from(database_path).parent() {
        fs::create_dir_all(parent)?;
    }

    let connection = Connection::open(database_path)?;

    connection.execute(
        "
        CREATE TABLE IF NOT EXISTS jobs (
            job_id TEXT PRIMARY KEY,
            site TEXT NOT NULL,
            dataset_id TEXT NOT NULL,
            workflow TEXT NOT NULL,
            status TEXT NOT NULL,
            created_at TEXT NOT NULL,
            started_at TEXT,
            completed_at TEXT,
            exit_code INTEGER,
            log_path TEXT
        )
        ",
        [],
    )?;

    let columns: Vec<String> = {
        let mut statement = connection.prepare("PRAGMA table_info(jobs)")?;

        let rows = statement.query_map([], |row| row.get::<_, String>(1))?;

        rows.filter_map(Result::ok).collect()
    };

    if !columns.iter().any(|column| column == "started_at") {
        connection.execute(
            "
            ALTER TABLE jobs
            ADD COLUMN started_at TEXT
            ",
            [],
        )?;
    }

    if !columns.iter().any(|column| column == "log_path") {
        connection.execute(
            "
            ALTER TABLE jobs
            ADD COLUMN log_path TEXT
            ",
            [],
        )?;
    }

    Ok(connection)
}

// ============================================================
// MAIN
// ============================================================

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    tracing_subscriber::fmt().with_target(false).json().init();

    // ========================================================
    // GENERAL CONFIG
    // ========================================================

    let site_id = env::var("SITE_ID").unwrap_or_else(|_| "site-a".to_string());

    let dataset_id = env::var("DATASET_ID").unwrap_or_else(|_| "dataset-001".to_string());

    let listen_addr = env::var("LISTEN_ADDR").unwrap_or_else(|_| "127.0.0.1:8080".to_string());

    let pipeline_dir =
        env::var("PIPELINE_DIR").unwrap_or_else(|_| "/genomics/work/nextflow-site-a".to_string());

    let database_path = env::var("DATABASE_PATH")
        .unwrap_or_else(|_| "/genomics/work/federation/jobs.db".to_string());

    let opa_url = env::var("OPA_URL")
        .unwrap_or_else(|_| "http://127.0.0.1:8181/v1/data/genomics/authz/allow".to_string());

    // ========================================================
    // JWT / KEYCLOAK CONFIG
    // ========================================================

    let site_a_issuer = env::var("SITE_A_ISSUER")
        .unwrap_or_else(|_| "https://10.10.10.10:9443/realms/genomics".to_string());

    let site_b_issuer = env::var("SITE_B_ISSUER")
        .unwrap_or_else(|_| "https://10.20.20.10:9443/realms/genomics".to_string());

    let keycloak_ca_path = env::var("KEYCLOAK_CA_PATH")
        .unwrap_or_else(|_| "/etc/federation-tls/ca/ca.crt".to_string());

    let jwt_audience = env::var("JWT_AUDIENCE").unwrap_or_else(|_| "federation-api".to_string());

    let trusted_issuers = vec![
        TrustedIssuer {
            issuer: site_a_issuer.clone(),

            institution: "site-a".to_string(),

            jwks_url: format!("{}/protocol/openid-connect/certs", site_a_issuer),
        },
        TrustedIssuer {
            issuer: site_b_issuer.clone(),

            institution: "site-b".to_string(),

            jwks_url: format!("{}/protocol/openid-connect/certs", site_b_issuer),
        },
    ];

    // ========================================================
    // DATABASE
    // ========================================================

    let connection = initialize_database(&database_path)?;

    // ========================================================
    // HTTP CLIENT
    // ========================================================

    let federation_ca = load_ca_certificate(&keycloak_ca_path)?;

    let http_client = Client::builder()
        .add_root_certificate(federation_ca)
        .timeout(Duration::from_secs(5))
        .build()?;

    // ========================================================
    // JWT KEYS
    // ========================================================

    let jwt_keys = load_jwt_keys(&http_client, &trusted_issuers).await?;

    let jwt_key_count = jwt_keys.len();

    // ========================================================
    // PROMETHEUS
    // ========================================================

    let registry = Registry::new();

    let request_counter = IntCounterVec::new(
        prometheus::Opts::new("federation_requests_total", "Total federation API requests"),
        &["endpoint"],
    )?;

    let denied_counter = IntCounterVec::new(
        prometheus::Opts::new(
            "federation_denied_total",
            "Total federation requests denied",
        ),
        &["reason"],
    )?;

    let opa_decision_counter = IntCounterVec::new(
        prometheus::Opts::new(
            "federation_opa_decisions_total",
            "OPA authorization decisions",
        ),
        &["decision"],
    )?;

    let jwt_counter = IntCounterVec::new(
        prometheus::Opts::new("federation_jwt_validation_total", "JWT validation outcomes"),
        &["result"],
    )?;

    let job_duration = HistogramVec::new(
        HistogramOpts::new(
            "federation_job_duration_seconds",
            "Federated genomic workflow duration",
        ),
        &["workflow"],
    )?;

    registry.register(Box::new(request_counter.clone()))?;

    registry.register(Box::new(denied_counter.clone()))?;

    registry.register(Box::new(opa_decision_counter.clone()))?;

    registry.register(Box::new(jwt_counter.clone()))?;

    registry.register(Box::new(job_duration.clone()))?;

    // ========================================================
    // APPLICATION STATE
    // ========================================================

    let state = AppState {
        site_id: site_id.clone(),

        dataset_id,

        pipeline_dir,

        opa_url: opa_url.clone(),

        jwt_audience: jwt_audience.clone(),

        http_client,

        trusted_issuers,

        jwt_keys: Arc::new(jwt_keys),

        db: Arc::new(Mutex::new(connection)),

        registry,

        request_counter,

        denied_counter,

        opa_decision_counter,

        jwt_counter,

        job_duration,
    };

    // ========================================================
    // ROUTES
    // ========================================================

    let app = Router::new()
        .route("/health", get(health))
        .route("/datasets", get(datasets))
        .route("/capabilities", get(capabilities))
        .route("/jobs", post(submit_job))
        .route("/jobs/{job_id}", get(job_status))
        .route("/raw-export", post(raw_export))
        .route("/metrics", get(metrics))
        .with_state(state);

    // ========================================================
    // LISTENER
    // ========================================================

    let socket_address: SocketAddr = listen_addr.parse()?;

    info!(
        site = %site_id,
        address = %socket_address,
        opa_url = %opa_url,
        site_a_issuer = %site_a_issuer,
        site_b_issuer = %site_b_issuer,
        jwt_audience = %jwt_audience,
        jwt_key_count = jwt_key_count,
        "Federation agent starting"
    );

    let listener = tokio::net::TcpListener::bind(socket_address).await?;

    axum::serve(listener, app).await?;

    Ok(())
}
